{
    "general": {
        "type": "object",
        "description": "通用",
        "items": {
            "command_style": {
                "type": "string",
                "description": "命令写法",
                "default": "mention",
                "hint": "帮助和回复里怎么显示命令，只影响显示。@机器人 tarkov 适合 QQ 官方机器人等平台，/tarkov 适合支持 / 唤醒的平台；两种写法实际都能用。",
                "options": [
                    "mention",
                    "slash"
                ],
                "labels": [
                    "@机器人 tarkov",
                    "/tarkov"
                ]
            },
            "qq_single_word_commands": {
                "type": "bool",
                "description": "QQ 官方机器人单词命令",
                "default": true,
                "hint": "QQ 官方机器人的命令里不能有空格。开启后可用 tpvp、tpve、tseason、tarena（查玩家）、tbind、tunbind、thelp（绑定、解绑、帮助）、tstatus、tboss（状态、Boss），后面的参数可以带空格，例如“@机器人 tpve 昵称”。到 QQ 机器人后台把它们加进命令列表即可。"
            },
            "access_mode": {
                "type": "string",
                "description": "谁可以使用",
                "default": "all",
                "hint": "“管理员”指 AstrBot 管理员，不是群管理员。",
                "options": [
                    "admin_only",
                    "admin_and_whitelist",
                    "all"
                ],
                "labels": [
                    "仅管理员",
                    "管理员和指定用户",
                    "所有人"
                ]
            },
            "user_whitelist": {
                "type": "list",
                "description": "指定用户",
                "default": [],
                "hint": "平台用户 ID（如 QQ 号），在“管理员和指定用户”时生效。"
            },
            "allowed_origins": {
                "type": "list",
                "description": "限定聊天",
                "default": [],
                "hint": "只允许这些会话使用，填 AstrBot 会话标识（聊天里发 /sid 查看）；留空不限制。"
            },
            "proxy_enabled": {
                "type": "bool",
                "description": "访问 tarkov.dev 时使用代理",
                "default": false,
                "hint": "开启后所有请求都走下面的代理，代理连不上不会改为直连。查询提示“HTTP 403”（服务器 IP 被拦）时可以开启。"
            },
            "proxy_url": {
                "type": "string",
                "description": "代理地址",
                "default": "",
                "hint": "HTTP/HTTPS 代理，写明端口，如 http://127.0.0.1:7890，不支持 SOCKS。"
            },
            "public_data_cache_minutes": {
                "type": "int",
                "description": "公共游戏数据缓存（分钟）",
                "default": 5,
                "hint": "状态和 Boss 共用，过期后的查询才会检查更新；0 表示每次都检查。",
                "slider": {
                    "min": 0,
                    "max": 1440,
                    "step": 1
                }
            }
        }
    },
    "player": {
        "type": "object",
        "description": "玩家数据查询",
        "items": {
            "default_mode": {
                "type": "string",
                "description": "默认模式",
                "default": "pvp",
                "hint": "命令里没写模式时先看这个模式；没有档案会自动换成有档案的模式。",
                "options": [
                    "pvp",
                    "pve",
                    "season"
                ],
                "labels": [
                    "PVP",
                    "PVE",
                    "PVP 赛季"
                ]
            },
            "arena_by_default": {
                "type": "bool",
                "description": "不写模式时也查竞技场",
                "default": false,
                "hint": "开启后每次查询多一个请求。"
            },
            "output_mode": {
                "type": "string",
                "description": "输出方式",
                "default": "image",
                "hint": "图片在本地绘制，画不出时自动改发文字；Markdown 在 QQ 上会显示出原始符号。",
                "options": [
                    "image",
                    "text",
                    "markdown"
                ],
                "labels": [
                    "图片",
                    "文字",
                    "Markdown 文字"
                ]
            },
            "skill_count": {
                "type": "int",
                "description": "显示的技能数",
                "default": 10,
                "hint": "精英技能总是全部显示，这里设置其余技能显示几项；0 不显示。",
                "slider": {
                    "min": 0,
                    "max": 49,
                    "step": 1
                }
            },
            "profile_cache_minutes": {
                "type": "int",
                "description": "档案缓存（分钟）",
                "default": 10,
                "hint": "只存内存；用玩家页网址查询和绑定时不用缓存；0 不缓存。",
                "slider": {
                    "min": 0,
                    "max": 1440,
                    "step": 5
                }
            },
            "name_index_enabled": {
                "type": "bool",
                "description": "同时使用 tarkov.dev 的昵称名单",
                "default": true,
                "hint": "按昵称查不到时，再查 tarkov.dev 的昵称名单。首次按昵称查 PVP 会下载约 30 MB，本地约占 100 MB，需要等几十秒。"
            },
            "name_index_refresh_hours": {
                "type": "int",
                "description": "昵称名单更新间隔（小时）",
                "default": 168,
                "hint": "名单每天更新，间隔到了再查询时才会重新下载。",
                "slider": {
                    "min": 1,
                    "max": 720,
                    "step": 1
                }
            },
            "download_timeout_seconds": {
                "type": "int",
                "description": "下载最长等待（秒）",
                "default": 120,
                "hint": "下载昵称名单的超时；查单个档案最多等 60 秒。",
                "slider": {
                    "min": 15,
                    "max": 900,
                    "step": 15
                }
            }
        }
    },
    "status": {
        "type": "object",
        "description": "服务器状态",
        "items": {
            "status_enabled": {
                "type": "bool",
                "description": "服务器状态功能",
                "default": false,
                "hint": "开启后可用 tarkov status 查询服务器状态图片。关闭时不下载数据。"
            },
            "status_broadcast_enabled": {
                "type": "bool",
                "description": "状态变化推送",
                "default": false,
                "hint": "状态变化时自动发图；首次只记录不推送。需要先开启上面的“服务器状态功能”。"
            },
            "status_poll_minutes": {
                "type": "int",
                "description": "状态检查间隔（分钟）",
                "default": 30,
                "hint": "10～90 分钟，保存后生效。",
                "slider": {
                    "min": 10,
                    "max": 90,
                    "step": 1
                }
            },
            "status_notify_targets": {
                "type": "list",
                "description": "状态推送目标",
                "default": [],
                "hint": "留空：推送给所有用过本插件命令的群。填写：只推送给这些会话（完整会话标识，聊天里发 /sid 查看，最多 50 个）。"
            },
            "status_qq_push_enabled": {
                "type": "bool",
                "description": "允许向 QQ 官方机器人推送状态",
                "default": false,
                "hint": "向 QQ 官方群推送前必须开启，还需要机器人有主动消息权限。"
            }
        }
    },
    "boss": {
        "type": "object",
        "description": "Boss 刷率",
        "items": {
            "boss_enabled": {
                "type": "bool",
                "description": "Boss 刷率功能",
                "default": false,
                "hint": "总开关：关闭后不能查询，也不会检查或推送。开启后可用 tarkov boss 查询刷率全表图。"
            },
            "boss_broadcast_enabled": {
                "type": "bool",
                "description": "刷率变化推送",
                "default": false,
                "hint": "只管推送：关闭后查询照常。刷率变化时自动发图，图下方文字写明变化；首次只记录不推送。"
            },
            "boss_poll_minutes": {
                "type": "int",
                "description": "刷率检查间隔（分钟）",
                "default": 30,
                "hint": "10～90 分钟，保存后生效。",
                "slider": {
                    "min": 10,
                    "max": 90,
                    "step": 1
                }
            },
            "boss_modes": {
                "type": "list",
                "description": "监控和默认查询的模式",
                "default": [
                    "pvp",
                    "pve",
                    "season"
                ],
                "hint": "可填 pvp、pve、season。新加的模式第一次只记录不推送；留空则不监控，但仍可 tarkov boss pve 这样指定模式查询。"
            },
            "boss_notify_targets": {
                "type": "list",
                "description": "刷率推送目标",
                "default": [],
                "hint": "留空：推送给所有用过本插件命令的群。填写：只推送给这些会话（完整会话标识，聊天里发 /sid 查看，最多 50 个）。"
            },
            "boss_qq_push_enabled": {
                "type": "bool",
                "description": "允许向 QQ 官方机器人推送刷率",
                "default": false,
                "hint": "向 QQ 官方群推送前必须开启，还需要机器人有主动消息权限。"
            },
            "boss_event_ignore": {
                "type": "list",
                "description": "不当作活动 Boss 的怪物（高级）",
                "default": [],
                "hint": "表格里除常驻 Boss 外，非 Raider、黑色军团、USEC、BEAR、游荡者、守军的 Boss 会显示为“活动”。上游新增了不想显示的普通怪物时，在这里填它的 normalizedName（如 raider）。"
            },
            "boss_portraits_update": {
                "type": "bool",
                "description": "拉取 Boss 头像（执行一次后自动关闭）",
                "default": false,
                "hint": "打开并保存后，从 assets.tarkov.dev 下载 12 个头像并缓存 365 天，之后自动关闭。平时不会自动下载；没有头像时用占位圆。"
            }
        }
    }
}
